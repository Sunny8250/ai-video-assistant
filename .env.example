# ─── Mistral AI (Required for Summarization, Extraction, RAG) ───
# Get your API key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# ─── Whisper Model (Optional - defaults to "small") ─────────────
# Options: tiny, base, small, medium, large
WHISPER_MODEL=small

# ─── Sarvam AI (Optional - only required for Hinglish translation) ─
# Get your API key at: https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v2.5

# ─── YouTube Cookies (Optional - for restricted or bot-protected videos) ─
# Export Netscape cookies from browser using Get cookies.txt extension
# YOUTUBE_COOKIES_FILE=cookies.txt

